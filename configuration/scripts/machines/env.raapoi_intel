#!/bin/csh -f

limit coredumpsize unlimited
limit stacksize unlimited

source /nfs/home/paulinan/software/pskrips-iimpi-2022a-env.csh

if (! $?PSKRIPS_NATIVE_PREFIX) then
  echo "PSKRIPS_NATIVE_PREFIX is not set; source the native environment first"
  exit 2
endif

setenv ICE_MACHINE_MACHNAME raapoi
setenv ICE_MACHINE_MACHINFO "Raapoi native Intel compiler and Intel MPI"
setenv ICE_MACHINE_ENVNAME intel
setenv ICE_MACHINE_ENVINFO "Intel classic 2021.6, Intel MPI 2021.6, native NetCDF 4.9.2"
setenv ICE_MACHINE_MAKE make
setenv ICE_MACHINE_WKDIR /nfs/scratch/paulinan/cice-dirs/runs
setenv ICE_MACHINE_INPUTDATA /nfs/scratch/paulinan/cice-dirs/input
setenv ICE_MACHINE_BASELINE /nfs/scratch/paulinan/cice-dirs/baseline
setenv ICE_MACHINE_SUBMIT "qsub"
setenv ICE_MACHINE_ACCT P00000000
setenv ICE_MACHINE_QUEUE "parallel"
setenv ICE_MACHINE_TPNODE 128
setenv ICE_MACHINE_BLDTHRDS 8
setenv ICE_MACHINE_QSTAT "qstat "
