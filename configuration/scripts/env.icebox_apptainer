#!/bin/csh -f

limit coredumpsize unlimited
limit stacksize unlimited

setenv SIF_FILE /Users/home/paulinan/models/coupled_model_apptainer/esmfenv86.sif

setenv I_MPI_ROOT /opt/intel/oneapi/mpi/2021.10.0
